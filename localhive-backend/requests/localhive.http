### 1. Check Setup Status
GET http://localhost:8080/api/setup/status
Accept: application/json

### 2. Initialize System (Create Admin)
POST http://localhost:8080/api/setup
Content-Type: application/json

{
  "username": "Adrian",
  "password": "SuperSecretPassword123!"
}

### 3. Admin Login (Get JWT Token)
POST http://localhost:8080/api/auth/login
Content-Type: application/json

{
  "username": "Adrian",
  "password": "SuperSecretPassword123!"
}

> {%
client.global.set("auth_token", response.body.token);
%}

### 4. Register a new Machine (Happy Path)
POST http://localhost:8080/api/workers/register
Content-Type: application/json

{
  "hostname": "Adrian-PC",
  "ipAddress": "192.168.66.3",
  "osType": "Windows 11",
  "totalRamMb": 32768,
  "sharedRamMb": 4096,
  "cpuCores": 16,
  "gpuName": "RTX 5080"
}

> {%
client.global.set("worker_uuid", response.body.workerId);
%}

### 5. Register a Machine (Error: Custom RAM Validator)
POST http://localhost:8080/api/workers/register
Content-Type: application/json

{
  "hostname": "Test-PC",
  "ipAddress": "10.0.0.1",
  "osType": "Linux",
  "totalRamMb": 2,
  "sharedRamMb": 4096,
  "cpuCores": 4,
  "gpuName": null
}

### 6. Send Heartbeat
POST http://localhost:8080/api/workers/{{worker_uuid}}/heartbeat
X-API-KEY: {{api_key}}

### 7. Get all registered workers
GET http://localhost:8080/api/admin/workers
Accept: application/json
Authorization: Bearer {{auth_token}}

### 8. Approve a specific worker
#POST http://localhost:8080/api/admin/workers/{{worker_uuid}}/approve
POST http://localhost:8080/api/admin/workers/bcd904a2-5fe6-4a64-8203-276416b8d90b/approve
Content-Type: application/json
Authorization: Bearer {{auth_token}}

> {%
client.global.set("api_key", response.body.apiKey);
%}

### 9. Update worker allocation (Happy Path: change only shared RAM)
PATCH http://localhost:8080/api/workers/{{worker_uuid}}/allocation
Content-Type: application/json
X-API-KEY: {{api_key}}

{
  "sharedRamMb": 8192
}

### 10. Update worker allocation (Sad Path: shared RAM exceeds total RAM)
PATCH http://localhost:8080/api/workers/{{worker_uuid}}/allocation
Content-Type: application/json
X-API-KEY: {{api_key}}

{
  "sharedRamMb": 65536
}

### 11. Update worker hardware spec (Happy Path: report changed hardware + RAM together)
PATCH http://localhost:8080/api/workers/{{worker_uuid}}/spec
Content-Type: application/json
X-API-KEY: {{api_key}}

{
  "hostname": "Adrian-PC-Updated",
  "ipAddress": "192.168.66.3",
  "osType": "Windows 11 Pro",
  "totalRamMb": 65536,
  "sharedRamMb": 8192,
  "cpuCores": 32,
  "gpuName": "RTX 5090"
}

### 12. Update worker hardware spec (Sad Path: total RAM changed without shared RAM)
PATCH http://localhost:8080/api/workers/{{worker_uuid}}/spec
Content-Type: application/json
X-API-KEY: {{api_key}}

{
  "totalRamMb": 65536,
  "cpuCores": 32,
  "gpuName": "RTX 5090"
}

### 13. Update worker allocation (Sad Path: missing X-API-KEY)
PATCH http://localhost:8080/api/workers/{{worker_uuid}}/allocation
Content-Type: application/json

{
  "sharedRamMb": 8192
}

